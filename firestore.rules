rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admin can read/write all user documents
      allow read, write: if request.auth != null && request.auth.token.email == "officialzoom200@gmail.com";
    }

    // Notifications: users read their own, admin reads all
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == "officialzoom200@gmail.com"
      );
      allow write: if request.auth != null && request.auth.token.email == "officialzoom200@gmail.com";
    }

    // Ban status listener: read-only for own UID
    match /banned/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.token.email == "officialzoom200@gmail.com";
    }

    // Deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
