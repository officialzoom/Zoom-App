{
  "name": "workspace",
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "scripts": {
    "dev": "PORT=3000 pnpm --filter @workspace/zoom-ng dev",
    "preinstall": "echo 'Skipping preinstall'",
    "build": "pnpm run typecheck && pnpm --filter @workspace/zoom-ng run build",
    "typecheck:libs": "tsc --build",
    "migrate:firestore-to-rtdb": "node scripts/migrate-firestore-to-rtdb.mjs",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "firebase-admin": "13.7.0"
  }
}
